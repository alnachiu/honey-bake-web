generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  // null = 该账号没有密码，只能用手机号免密登录。
  // 手机号注册（phone-login 自动建号）与店主后台「清除密码」都会写成 null；
  // 用户在「我的」页自行设过密码后即为普通哈希。任何地方拿它做 bcrypt 比较前
  // 必须先判空，否则 bcrypt 会抛错（被 catch 成 500）。
  password         String?
  phone            String            @default("")
  avatar           String            @default("")
  role             String            @default("user") // user | admin
  memberExpire     DateTime? // 会员到期时间；null 或早于当前 = 非会员
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orders           Order[]
  addresses        Address[]
  coupons          UserCoupon[]
  notifications    Notification[]
  membershipOrders MembershipOrder[]
  // 与店主的站内会话。一个消费者最多一条（ChatConversation.userId 是 @unique），
  // 所以这里是一对一而不是一对多。
  chatConversation ChatConversation?
}

model Product {
  id            String   @id @default(cuid())
  name          String
  price         Float
  originalPrice Float    @default(0)
  deliveryFee   Float    @default(0)
  category      String   @default("")
  unit          String   @default("份")
  stock         Int      @default(0)
  sales         Int      @default(0)
  images        String   @default("[]") // JSON array - 主图
  detailImages  String   @default("[]") // JSON array - 详情页图片(最多5张)
  description   String   @default("")
  detail        String   @default("")
  tags          String   @default("[]") // JSON array
  status        String   @default("on") // on | off
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // 店主在后台「↑↓」调出来的展示顺序，越小越前。
  // 0 是「还没排过序」——所以新建的商品天然排在最前面（与上架时间倒序的既有行为一致）；
  // 一旦店主调过顺序，重排接口会给每一项写入 1..n 的显式值，0 就只属于后来新建的。
  // 必须是最后一个标量字段：SQLite 的 ADD COLUMN 只能加在末列，插在中间会让 Prisma 重建整张表
  // （而 Product 被 OrderItem 引用着，能走 ADD COLUMN 就不要走重建）。
  sort          Int      @default(0)
  orderItems    OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  orderNo        String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  items          OrderItem[]
  totalAmount    Float
  deliveryFee    Float       @default(0)
  itemsAmount    Float       @default(0)
  couponDiscount Float       @default(0)
  memberDiscount Float       @default(0) // 会员折扣金额，单独记录便于对账
  // 买赠券带来的赠品，随单配送。赠品是自由文本、不关联商品，所以不能塞进 OrderItem
  // （那张表的 productId 是必填外键），只能挂在订单上。
  giftName       String      @default("")
  giftQuantity   Int         @default(0)
  remark         String      @default("")
  addressId      String?
  address        Address?    @relation(fields: [addressId], references: [id])
  // 收货信息快照。addressId 只是**引用**：消费者在「地址管理」里改一下或删掉地址，
  // 历史订单的收货人/电话/地址就会跟着变或直接变空白。所以成单时必须把当时的
  // 收货信息复制一份存在订单上，读取时优先用快照、快照为空再回退关联（兼容存量单）。
  receiverName   String?
  receiverPhone  String?
  receiverRegion String?
  receiverDetail String?
  // 下单当时是否为会员的快照。会员折扣率可能被店主设为 1（不打折），
  // 那时 memberDiscount 恒为 0，事后无法反推身份，所以必须在成单时落库，
  // 否则导出的「是否会员」列只能靠 memberDiscount > 0 猜。
  wasMember      Boolean     @default(false)
  // 消费者点击「已扫码支付」的时刻。仅代表用户声明已转账，
  // 收款与否仍由店主在后台确认（status 才是账面上的事实）。
  payClaimedAt   DateTime?
  status         String      @default("pending")
  trackingNo     String      @default("")
  payTime        DateTime?
  deliveryTime   DateTime?
  completeTime   DateTime?
  cancelTime     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  image     String  @default("")
  price     Float
  quantity  Int
  unit      String  @default("份")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String
  region    String   @default("")
  detail    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Coupon {
  id           String       @id @default(cuid())
  name         String
  type         String       // reduce 满减 | discount 折扣 | gift 买赠
  value        Float        // gift 类型恒为 0：赠品券只改订单上的赠品，不改金额
  minAmount    Float        @default(0)
  stock        Int          @default(0)
  claimed      Int          @default(0)
  validMode    String       @default("fixed") // fixed 固定日期区间 | relative 领取后 N 天
  startTime    String       @default("") // validMode=fixed：YYYY-MM-DDTHH:mm（旧数据为 YYYY-MM-DD）
  endTime      String       @default("") // validMode=fixed：YYYY-MM-DDTHH:mm
  validDays    Int          @default(0) // validMode=relative：领取后 N 天内有效
  description  String       @default("")
  stackable    Boolean      @default(false) // 是否可与其他优惠券叠加使用
  perUserLimit Int          @default(1) // 每人最多领取数量（总量，不区分时间），0 = 不限
  // type=gift：赠品名称与数量。刻意不关联 Product——店主只想写「曲奇一盒」这种自由文本
  giftName     String       @default("")
  giftQuantity Int          @default(0)
  // false = 隐藏券：消费者看不到、也不能自己领，只能店主在后台推送。但券本身仍然有效，
  // 被推送出去后照常核销（「隐藏」不等于「失效」）。
  visible      Boolean      @default(true)
  // 领取限制的时间维度，两种可分别启用，与上面的 perUserLimit 同时生效：
  rollingDays  Int          @default(0) // 滚动窗口：最近 N 天内……（0 = 不启用）
  rollingLimit Int          @default(0) // ……最多领取 M 张（0 = 不启用）
  periodType   String       @default("none") // none 不启用 | day | week | month 自然周期
  periodCount  Int          @default(0) // 每个自然周期内最多领取 K 张（0 = 不启用）
  status       String       @default("active") // active | expired
  createdAt    DateTime     @default(now())
  // 同 Product.sort：店主在后台「↑↓」调出来的展示顺序，越小越前，0 = 还没排过序（新建的排最前）。
  // 同样必须放末尾才走 ADD COLUMN。**唯一写入者是 /api/coupons/reorder**——
  // 千万不要把它加进 validateCouponInput 的白名单：那个 PUT 是全量覆盖，
  // 一旦 sort 进了白名单，「隐藏/显示」开关和编辑页就会拿着重排前捕获的旧值把顺序写回去。
  sort         Int          @default(0)
  userCoupons  UserCoupon[]
  planGifts    MembershipPlanCoupon[]
}

model UserCoupon {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  status     String    @default("active") // active | used | expired
  source     String    @default("claim") // claim 用户自领 | push 店主推送
  claimTime  DateTime  @default(now())
  expireTime DateTime? // validMode=relative 时落到具体到期时刻；fixed 模式由 coupon.endTime 决定
  useTime    DateTime?

  // claimTime 一起进索引：限领的时间维度（滚动窗口 / 自然周期）都按领取时刻统计
  @@index([userId, couponId, claimTime])
}

model ShopSetting {
  id             String @id @default("default")
  name           String @default("甜蜜烘焙")
  phone          String @default("")
  desc           String @default("用心烘焙每一份甜蜜")
  paymentQR      String @default("")
  layout         String @default("{}")
  memberDiscount Float  @default(1) // 会员折扣率：1 = 不打折，0.95 = 95 折
}

model MembershipPlan {
  id          String                 @id @default(cuid())
  name        String // 如「年卡」
  price       Float
  days        Int // 有效天数
  sort        Int                    @default(0)
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  orders      MembershipOrder[]
  giftCoupons MembershipPlanCoupon[]
}

// 每张会员卡各配一套「成为会员后自动推送」的券。
// 用关联表而不是 ShopSetting 里的 JSON 数组：这样删券/删套餐能靠外键级联自动清理，
// 不用在每个删除路径上手动维护那份数组。
model MembershipPlanCoupon {
  id        String         @id @default(cuid())
  planId    String
  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  couponId  String
  coupon    Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([planId, couponId])
}

model MembershipOrder {
  id        String         @id @default(cuid())
  orderNo   String         @unique
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  planId    String
  plan      MembershipPlan @relation(fields: [planId], references: [id])
  // 下单时快照，避免套餐后续改价改名影响历史记录
  planName  String
  price     Float
  days      Int
  status    String         @default("pending") // pending | paid | cancelled
  payTime   DateTime?
  // 消费者点击「我已付款」的时刻，用于告知店主「对方声称已转账」，
  // 与上面 Order.payClaimedAt 同理：声明不等于收款，开卡仍靠后台确认。
  payClaimedAt DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, status])
}

// 「联系小二」的站内聊天。
//
// 刻意不做成通用的多会话 IM：这个站只有一个店主，消费者要找的人永远是他，
// 所以「一个消费者一条会话」就够，userId 直接 @unique。店主侧看到的是一个会话列表。
//
// 消息是**临时**的：整条会话闲置 7 天后连消息一起清掉（见 lib/chat.ts）。
// 清除动作挂在下一次 GET /api/chat 上惰性执行，不引入 cron——
// 项目里已有的「配送中超过 7 天自动完成」就是这么做的（api/orders/route.ts）。
model ChatConversation {
  id            String        @id @default(cuid())
  userId        String        @unique
  // 用户注销时连会话一起删；消息靠 ChatMessage 上的级联跟着走
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 会话的「最后一条消息时刻」，同时也是 7 天清除的计时基准。
  // 独立成一列而不是每次去 max(ChatMessage.createdAt)：列表排序和清理都要用它，
  // 没有这列就得对每个会话各来一次子查询。
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  messages      ChatMessage[]

  // 清理和店主侧列表排序都按这个字段扫
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // user | admin。存角色而不是 userId：一来能直接决定气泡左右，
  // 二来店主换账号/加一个管理员也不会让历史消息的归属错乱。
  senderRole     String
  body           String
  // 收件方读过这条的时刻，null = 未读。未读数是店主侧列表的角标来源。
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  // 「清空聊天」是按边生效的：消息表是双方共用的，谁清了就给自己这边打个标记，
  // 查询时按列名过滤即可，对方的记录完全不受影响（店主删了不影响消费者，反之亦然）。
  // 刻意用布尔列而不是「各自的 clearedAt 时间戳」——时间戳方案要按父行的列去过滤子表，
  // 而 Prisma 的 include.where / groupBy.where 只能写常量条件，表达不出来，
  // 结果就是店主端的列表预览和未读角标都算不准。
  // 这两列必须放在模型**末尾**：插在中间会让 Prisma 判定为重建表，追加在后面才是
  // 纯 ADD COLUMN（SQLite 的 ADD COLUMN 只能加在末列）。
  deletedForUser  Boolean  @default(false)
  deletedForAdmin Boolean  @default(false)

  // 拉消息永远是「某个会话按时间正序」，这个复合索引正好覆盖
  @@index([conversationId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @default("")
  type      String   @default("system") // system | coupon | member | order（order = 订单/收款相关，含发给店主的待办通知）
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}
