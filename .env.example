# 本地开发（SQLite）：
# DATABASE_URL 的 file:./ 是相对 prisma/schema.prisma 所在目录（prisma/）解析的
DATABASE_URL="file:./dev.db"

# 部署到 Sealos/云服务器时，改为指向持久化卷的绝对路径，例如：
# DATABASE_URL="file:/app/data/prisma/dev.db"

# JWT 密钥。**必须**换成自己的随机值，否则服务起不来（src/lib/auth.ts 会拒绝）
# 生成一个：  openssl rand -base64 48       或       node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# ⚠️ 这里以前写的是 honey-bake-jwt-secret-key-2026。那个值曾经硬编码在
# src/lib/auth.ts、next.config.js、Dockerfile、docker-compose.yml 里，
# 并且随公开仓库一起发布过——等于把签名密钥公开发布，任何人都能自签登录态冒充店主。
# auth.ts 现在会显式拒绝这个值，抄旧值只会让服务启动失败，不会悄悄降级。
JWT_SECRET=

# 图片上传目录：本地默认项目内 uploads/；部署时指向持久化卷，例如：
# UPLOAD_DIR=/app/data/uploads
