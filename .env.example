# Neon PostgreSQL 数据库连接串（在 Neon Dashboard 获取）
DATABASE_URL="postgresql://..."

# JWT 密钥
JWT_SECRET=honey-bake-jwt-secret-key-2026

# Cloudinary 图片存储配置（在 https://cloudinary.com 注册免费账号获取）
# 登录后 Dashboard 会显示你的 Cloud Name、API Key 和 API Secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
